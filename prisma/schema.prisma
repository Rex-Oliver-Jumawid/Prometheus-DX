generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  ADMINISTRATOR
  MEMBER
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ProjectStatusChangeSource {
  USER
  SYSTEM
}

enum ProjectAccessLevel {
  CAN_VIEW
  CAN_EDIT
}

enum OutcomeLifecycleStatus {
  OPEN
  NEEDS_REVISION
  ACCEPTED
}

enum TaskStatus {
  TODO
  DONE
}

enum SubmissionReviewStatus {
  FOR_REVIEW
  REVIEWED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum WorkSessionStatus {
  OPEN
  COMPLETED
  NEEDS_CORRECTION
}

enum NotificationType {
  OUTCOME_JOINED
  SUBMISSION_CREATED
  REVISION_REQUESTED
  OUTCOME_ACCEPTED
}

model Department {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  shortLabel  String              @map("short_label") @db.VarChar(12)
  description String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  members     Member[]
  projects    ProjectDepartment[]
  outcomes    OutcomeDepartment[]

  @@index([name])
  @@map("departments")
}

model Member {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId                  String?                      @unique @map("auth_user_id") @db.Uuid
  email                       String
  fullName                    String                       @map("full_name")
  departmentId                String                       @map("department_id") @db.Uuid
  department                  Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workspaceRole               WorkspaceRole                @default(MEMBER) @map("workspace_role")
  status                      MemberStatus                 @default(INVITED)
  position                    String?
  profileImagePath            String?                      @map("profile_image_path")
  invitationSentAt            DateTime?                    @map("invitation_sent_at") @db.Timestamptz(6)
  deactivatedAt               DateTime?                    @map("deactivated_at") @db.Timestamptz(6)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdProjects             Project[]                    @relation("ProjectCreatedBy")
  ledProjects                 Project[]                    @relation("ProjectLead")
  projectStatusChanges        ProjectStatusHistory[]       @relation("ProjectStatusChangedBy")
  projectMemberships          ProjectMember[]
  projectAccessChanges        ProjectMemberAccessHistory[] @relation("ProjectAccessChangedBy")
  projectAccessHistory        ProjectMemberAccessHistory[] @relation("ProjectAccessTarget")
  createdOutcomes             Outcome[]                    @relation("OutcomeCreatedBy")
  outcomeMemberships          OutcomeMember[]
  resolvedOutcomeDependencies OutcomeDependency[]          @relation("OutcomeDependencyResolvedBy")
  createdFeatures             Feature[]
  createdTasks                Task[]                       @relation("TaskCreatedBy")
  completedTasks              Task[]                       @relation("TaskCompletedBy")
  outputDrafts                OutcomeOutputDraft[]
  submissions                 OutcomeSubmission[]
  activity                    ActivityLog[]
  submissionReviews           SubmissionReview[]
  requestedRevisions          OutcomeRevisionRequest[]     @relation("RevisionRequestedBy")
  resolvedRevisions           OutcomeRevisionRequest[]     @relation("RevisionResolvedBy")
  reviewDrafts                OutcomeReviewDraft[]
  acceptedOutcomes            OutcomeAcceptance[]          @relation("OutcomeAcceptedBy")
  reopenedOutcomes            OutcomeAcceptance[]          @relation("OutcomeReopenedBy")
  acceptanceCredits           OutcomeAcceptanceMember[]
  schedule                    MemberSchedule?
  workSessions                WorkSession[]
  workSessionCorrections      WorkSessionCorrection[]
  receivedNotifications       Notification[]               @relation("NotificationRecipient")
  actedNotifications          Notification[]               @relation("NotificationActor")

  @@index([departmentId])
  @@index([status])
  @@map("members")
}

model MemberSchedule {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId            String          @unique @map("member_id") @db.Uuid
  targetWeeklyMinutes Int             @map("target_weekly_minutes")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  member              Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  blocks              ScheduleBlock[]

  @@map("member_schedules")
}

model ScheduleBlock {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String         @map("schedule_id") @db.Uuid
  weekday    Weekday
  startTime  DateTime       @map("start_time") @db.Time(0)
  endTime    DateTime       @map("end_time") @db.Time(0)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedule   MemberSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday, startTime, endTime])
  @@index([scheduleId, weekday, startTime])
  @@map("schedule_blocks")
}

model WorkSession {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId    String                  @map("member_id") @db.Uuid
  timeIn      DateTime                @map("time_in") @db.Timestamptz(6)
  timeOut     DateTime?               @map("time_out") @db.Timestamptz(6)
  status      WorkSessionStatus       @default(OPEN)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  member      Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  corrections WorkSessionCorrection[]

  @@index([memberId, timeIn])
  @@index([memberId, status])
  @@map("work_sessions")
}

model WorkSessionCorrection {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workSessionId   String      @map("work_session_id") @db.Uuid
  memberId        String      @map("member_id") @db.Uuid
  previousTimeIn  DateTime    @map("previous_time_in") @db.Timestamptz(6)
  previousTimeOut DateTime?   @map("previous_time_out") @db.Timestamptz(6)
  newTimeIn       DateTime    @map("new_time_in") @db.Timestamptz(6)
  newTimeOut      DateTime    @map("new_time_out") @db.Timestamptz(6)
  reason          String
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  workSession     WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Restrict)
  member          Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([workSessionId, createdAt])
  @@index([memberId, createdAt])
  @@map("work_session_corrections")
}

model Project {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  description         String
  status              ProjectStatus                @default(PLANNING)
  createdByMemberId   String                       @map("created_by_member_id") @db.Uuid
  leadMemberId        String                       @map("lead_member_id") @db.Uuid
  doneAt              DateTime?                    @map("done_at") @db.Timestamptz(6)
  archivedAt          DateTime?                    @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByMember     Member                       @relation("ProjectCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  leadMember          Member                       @relation("ProjectLead", fields: [leadMemberId], references: [id], onDelete: Restrict)
  departments         ProjectDepartment[]
  statusHistory       ProjectStatusHistory[]
  stages              Stage[]
  members             ProjectMember[]
  memberAccessHistory ProjectMemberAccessHistory[]
  activity            ActivityLog[]
  notifications       Notification[]

  @@index([createdByMemberId])
  @@index([leadMemberId])
  @@index([status])
  @@map("projects")
}

model ProjectDepartment {
  projectId    String     @map("project_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([projectId, departmentId])
  @@index([departmentId])
  @@map("project_departments")
}

model ProjectStatusHistory {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String                    @map("project_id") @db.Uuid
  fromStatus        ProjectStatus?            @map("from_status")
  toStatus          ProjectStatus             @map("to_status")
  changedByMemberId String?                   @map("changed_by_member_id") @db.Uuid
  changeSource      ProjectStatusChangeSource @map("change_source")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedByMember   Member?                   @relation("ProjectStatusChangedBy", fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([changedByMemberId])
  @@map("project_status_history")
}

model ProjectMember {
  projectId   String             @map("project_id") @db.Uuid
  memberId    String             @map("member_id") @db.Uuid
  accessLevel ProjectAccessLevel @default(CAN_VIEW) @map("access_level")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member      Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([projectId, memberId])
  @@index([memberId])
  @@map("project_members")
}

model ProjectMemberAccessHistory {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  memberId          String             @map("member_id") @db.Uuid
  previousAccess    ProjectAccessLevel @map("previous_access")
  newAccess         ProjectAccessLevel @map("new_access")
  changedByMemberId String             @map("changed_by_member_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member            Member             @relation("ProjectAccessTarget", fields: [memberId], references: [id], onDelete: Restrict)
  changedByMember   Member             @relation("ProjectAccessChangedBy", fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([projectId, memberId])
  @@index([changedByMemberId])
  @@map("project_member_access_history")
}

model Stage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String
  description String?
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outcomes    Outcome[]

  @@unique([projectId, position])
  @@index([projectId])
  @@map("stages")
}

model Outcome {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageId            String                   @map("stage_id") @db.Uuid
  title              String
  description        String?
  lifecycleStatus    OutcomeLifecycleStatus   @default(OPEN) @map("lifecycle_status")
  position           Int
  createdByMemberId  String                   @map("created_by_member_id") @db.Uuid
  acceptedAt         DateTime?                @map("accepted_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  stage              Stage                    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdByMember    Member                   @relation("OutcomeCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  departments        OutcomeDepartment[]
  acceptanceCriteria AcceptanceCriterion[]
  members            OutcomeMember[]
  prerequisites      OutcomeDependency[]      @relation("DependentOutcome")
  dependents         OutcomeDependency[]      @relation("PrerequisiteOutcome")
  features           Feature[]
  outputDrafts       OutcomeOutputDraft[]
  submissions        OutcomeSubmission[]
  activity           ActivityLog[]
  reviewDrafts       OutcomeReviewDraft[]
  revisionRequests   OutcomeRevisionRequest[]
  acceptances        OutcomeAcceptance[]
  notifications      Notification[]

  @@unique([stageId, position])
  @@index([stageId])
  @@index([lifecycleStatus])
  @@index([createdByMemberId])
  @@map("outcomes")
}

model OutcomeDepartment {
  outcomeId    String     @map("outcome_id") @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  outcome      Outcome    @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([outcomeId, departmentId])
  @@index([departmentId])
  @@map("outcome_departments")
}

model OutcomeMember {
  outcomeId String   @map("outcome_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  outcome   Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([outcomeId, memberId])
  @@index([memberId])
  @@map("outcome_members")
}

model OutcomeDependency {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outcomeId                  String    @map("outcome_id") @db.Uuid
  prerequisiteOutcomeId      String    @map("prerequisite_outcome_id") @db.Uuid
  overrideResolvedAt         DateTime? @map("override_resolved_at") @db.Timestamptz(6)
  overrideResolvedByMemberId String?   @map("override_resolved_by_member_id") @db.Uuid
  overrideReason             String?   @map("override_reason")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  outcome                    Outcome   @relation("DependentOutcome", fields: [outcomeId], references: [id], onDelete: Cascade)
  prerequisiteOutcome        Outcome   @relation("PrerequisiteOutcome", fields: [prerequisiteOutcomeId], references: [id], onDelete: Restrict)
  overrideResolvedByMember   Member?   @relation("OutcomeDependencyResolvedBy", fields: [overrideResolvedByMemberId], references: [id], onDelete: Restrict)

  @@unique([outcomeId, prerequisiteOutcomeId])
  @@index([outcomeId])
  @@index([prerequisiteOutcomeId])
  @@index([overrideResolvedByMemberId])
  @@map("outcome_dependencies")
}

model AcceptanceCriterion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outcomeId   String   @map("outcome_id") @db.Uuid
  description String
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  outcome     Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@unique([outcomeId, position])
  @@index([outcomeId])
  @@map("acceptance_criteria")
}

model Feature {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outcomeId         String   @map("outcome_id") @db.Uuid
  title             String
  description       String?
  position          Int
  createdByMemberId String   @map("created_by_member_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  outcome           Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  createdByMember   Member   @relation(fields: [createdByMemberId], references: [id], onDelete: Restrict)
  tasks             Task[]

  @@unique([outcomeId, position])
  @@index([createdByMemberId])
  @@map("features")
}

model Task {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId           String     @map("feature_id") @db.Uuid
  title               String
  description         String?
  status              TaskStatus @default(TODO)
  position            Int
  createdByMemberId   String     @map("created_by_member_id") @db.Uuid
  completedByMemberId String?    @map("completed_by_member_id") @db.Uuid
  completedAt         DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  feature             Feature    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdByMember     Member     @relation("TaskCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  completedByMember   Member?    @relation("TaskCompletedBy", fields: [completedByMemberId], references: [id], onDelete: Restrict)

  @@unique([featureId, position])
  @@index([createdByMemberId])
  @@index([completedByMemberId])
  @@map("tasks")
}

model OutcomeOutputDraft {
  outcomeId String   @map("outcome_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  content   String
  note      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  outcome   Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([outcomeId, memberId])
  @@index([memberId])
  @@map("outcome_output_drafts")
}

model OutcomeSubmission {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outcomeId           String                 @map("outcome_id") @db.Uuid
  submittedByMemberId String                 @map("submitted_by_member_id") @db.Uuid
  content             String
  note                String
  reviewStatus        SubmissionReviewStatus @default(FOR_REVIEW) @map("review_status")
  requestId           String                 @map("request_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  outcome             Outcome                @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  submittedByMember   Member                 @relation(fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  reviews             SubmissionReview[]

  @@unique([outcomeId, submittedByMemberId, requestId])
  @@index([outcomeId, createdAt])
  @@index([submittedByMemberId])
  @@index([reviewStatus])
  @@map("outcome_submissions")
}

model ActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorMemberId String?  @map("actor_member_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  outcomeId     String?  @map("outcome_id") @db.Uuid
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  action        String
  metadata      Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorMember   Member?  @relation(fields: [actorMemberId], references: [id], onDelete: Restrict)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outcome       Outcome? @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([outcomeId, createdAt])
  @@index([actorMemberId])
  @@map("activity_logs")
}

model SubmissionReview {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId       String            @map("submission_id") @db.Uuid
  reviewedByMemberId String            @map("reviewed_by_member_id") @db.Uuid
  reviewNote         String            @map("review_note")
  criteriaSnapshot   Json              @map("criteria_snapshot")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  submission         OutcomeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedByMember   Member            @relation(fields: [reviewedByMemberId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([reviewedByMemberId])
  @@map("submission_reviews")
}

model OutcomeRevisionRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outcomeId           String    @map("outcome_id") @db.Uuid
  requestedByMemberId String    @map("requested_by_member_id") @db.Uuid
  message             String
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedByMemberId  String?   @map("resolved_by_member_id") @db.Uuid
  outcome             Outcome   @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  requestedByMember   Member    @relation("RevisionRequestedBy", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  resolvedByMember    Member?   @relation("RevisionResolvedBy", fields: [resolvedByMemberId], references: [id], onDelete: Restrict)

  @@index([outcomeId, createdAt])
  @@index([requestedByMemberId])
  @@index([resolvedByMemberId])
  @@map("outcome_revision_requests")
}

model OutcomeReviewDraft {
  outcomeId    String   @map("outcome_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  criterionIds String[] @map("criterion_ids") @db.Uuid
  note         String
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  outcome      Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([outcomeId, memberId])
  @@index([memberId])
  @@map("outcome_review_drafts")
}

model OutcomeAcceptance {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outcomeId          String                    @map("outcome_id") @db.Uuid
  acceptedByMemberId String                    @map("accepted_by_member_id") @db.Uuid
  acceptedAt         DateTime                  @default(now()) @map("accepted_at") @db.Timestamptz(6)
  reopenedByMemberId String?                   @map("reopened_by_member_id") @db.Uuid
  reopenedAt         DateTime?                 @map("reopened_at") @db.Timestamptz(6)
  feedback           String
  criteriaSnapshot   Json                      @map("criteria_snapshot")
  outcome            Outcome                   @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  acceptedByMember   Member                    @relation("OutcomeAcceptedBy", fields: [acceptedByMemberId], references: [id], onDelete: Restrict)
  reopenedByMember   Member?                   @relation("OutcomeReopenedBy", fields: [reopenedByMemberId], references: [id], onDelete: Restrict)
  members            OutcomeAcceptanceMember[]

  @@index([outcomeId, acceptedAt])
  @@index([acceptedByMemberId])
  @@index([reopenedByMemberId])
  @@map("outcome_acceptances")
}

model OutcomeAcceptanceMember {
  acceptanceId String            @map("acceptance_id") @db.Uuid
  memberId     String            @map("member_id") @db.Uuid
  acceptance   OutcomeAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  member       Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@id([acceptanceId, memberId])
  @@index([memberId])
  @@map("outcome_acceptance_members")
}

model Notification {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientMemberId String           @map("recipient_member_id") @db.Uuid
  type              NotificationType
  eventKey          String           @map("event_key") @db.VarChar(200)
  projectId         String           @map("project_id") @db.Uuid
  outcomeId         String?          @map("outcome_id") @db.Uuid
  actorMemberId     String?          @map("actor_member_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  recipientMember   Member           @relation("NotificationRecipient", fields: [recipientMemberId], references: [id], onDelete: Restrict)
  actorMember       Member?          @relation("NotificationActor", fields: [actorMemberId], references: [id], onDelete: Restrict)
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  outcome           Outcome?         @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@unique([recipientMemberId, eventKey])
  @@index([recipientMemberId, createdAt(sort: Desc)])
  @@index([recipientMemberId, readAt, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([outcomeId])
  @@index([actorMemberId])
  @@map("notifications")
}
