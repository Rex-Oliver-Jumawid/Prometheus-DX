generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Phase 0 intentionally defines no business tables yet.
// Business entities are introduced from the canonical data-model.md in later phases.
// Prisma is already used for connectivity through $queryRaw in the health endpoint.
