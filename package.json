{
  "name": "prometheus-dx",
  "version": "0.1.0",
  "private": true,
  "description": "Prometheus Centralized Workflow Management System",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx --tsconfig tsconfig.server.json watch server/main.ts",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.build.json",
    "start:api": "node dist/server/main.js",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint \"{src,server,shared,tests}/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write src server shared tests .github package.json index.html eslint.config.mjs playwright.config.ts postcss.config.cjs tailwind.config.cjs vite.config.ts tsconfig*.json",
    "format:check": "prettier --check src server shared tests .github package.json index.html eslint.config.mjs playwright.config.ts postcss.config.cjs tailwind.config.cjs vite.config.ts tsconfig*.json",
    "project:doctor": "node scripts/doctor.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.66.0",
    "dotenv": "^16.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
