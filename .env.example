# Backend
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase PostgreSQL
# Use the pooled URL for normal application queries and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth - used by NestJS to verify bearer tokens. The anon key is safe
# for server verification; never use the service-role key in the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Member invitation delivery. These values are server-only and must never use
# a VITE_ prefix. APP_URL is the public origin used in account-setup links.
APP_URL=http://localhost:5173
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Prometheus

# Operational stale-session threshold. Open sessions older than this are
# flagged for self-correction and are never silently closed.
WORK_SESSION_MAX_HOURS=16

# Browser-exposed values. Never place service-role or database credentials in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional. Leave blank for same-origin /api behavior through the Vite proxy.
VITE_API_BASE_URL=/api

# Optional development-only seed input. Create the corresponding accounts in
# Supabase Auth first; omit authUserId to link a confirmed matching email on first sign-in.
# PROMETHEUS_SEED_MEMBERS_JSON=[{"email":"admin@example.com","fullName":"Admin User","departmentId":"00000000-0000-4000-8000-000000000001","workspaceRole":"ADMINISTRATOR","status":"ACTIVE","authUserId":"00000000-0000-4000-8000-000000000000","position":"Operations Lead"}]

# Optional credentials used only by the conditional Phase 1 Playwright flow.
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
