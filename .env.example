# Backend
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase PostgreSQL
# Use the pooled URL for normal application queries and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth - server-side foundation for later authentication phases
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Browser-exposed values. Never place service-role or database credentials in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional. Leave blank for same-origin /api behavior through the Vite proxy.
VITE_API_BASE_URL=/api
